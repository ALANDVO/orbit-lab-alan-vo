# Orbit Lab — environment configuration
# Copy to .env and fill in real values. Never commit .env.

# Database (SQLite file path or :memory:)
DATABASE_URL=sqlite:///./orbit_lab.db

# Environment: development, staging, production
ENVIRONMENT=development

# Worktree base directory for agent runs
ORBIT_WORKTREE_BASE=/tmp/orbit-worktrees

# Authentication (planned — not yet implemented in this checkpoint)
AUTH_ENABLED=false

# Keycloak OIDC (planned — not yet implemented)
KEYCLOAK_REALM=https://keycloak.example.com/realms/myrealm
KEYCLOAK_CLIENT_ID=orbit-lab
KEYCLOAK_CLIENT_SECRET=

# LLM provider (optional, for advisory explanations)
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=